// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RepositoryStatus {
  SUBMITTED
  QUEUED
  INDEXING
  INDEXED
  PARTIALLY_INDEXED
  FAILED
}

enum IndexingJobType {
  REPOSITORY_INDEX
}

enum IndexingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SnapshotProcessingStatus {
  PENDING
  RECOVERING
  DISCOVERING
  INGESTING
  COMPLETED
  FAILED
}

enum SnapshotCompleteness {
  COMPLETE
  PARTIAL
  FAILED
}

enum SnapshotFileStatus {
  DISCOVERED
  ELIGIBLE
  STORED
  SKIPPED
  FAILED
}

enum SnapshotFileCategory {
  SOURCE
  CONFIGURATION
  DOCUMENTATION
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  repositories    Repository[]
  codeAnalyses    CodeAnalysis[]
  findingsRuns    FindingsRun[]
  findingReviews  FindingReview[]
  aiConversations AIConversation[]
  aiUsageDays     AIUsageDay[]
  aiUsageRecords  AIUsageRecord[]
  researchRuns    ResearchRun[]
  researchSources ResearchSource[]
  researchUsage   ResearchUsageDay[]
  sessions        Session[]
  accounts        Account[]

  @@map("user")
}

model Repository {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  provider   String  @default("github")
  externalId String?
  githubId   BigInt?

  ownerLogin String
  name       String
  fullName   String
  htmlUrl    String

  description   String?
  visibility    String  @default("PUBLIC")
  defaultBranch String?
  language      String?
  stars         Int     @default(0)
  forks         Int     @default(0)
  lastCommitSha String?

  status RepositoryStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  indexingJobs    IndexingJob[]
  snapshots       RepositorySnapshot[]
  codeAnalyses    CodeAnalysis[]
  findingsRuns    FindingsRun[]
  findingReviews  FindingReview[]
  aiConversations AIConversation[]
  researchRuns    ResearchRun[]

  @@unique([ownerId, fullName])
  @@unique([ownerId, githubId])
  @@index([ownerId])
  @@index([ownerId, status])
}

model IndexingJob {
  id String @id @default(cuid())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  type            IndexingJobType   @default(REPOSITORY_INDEX)
  status          IndexingJobStatus @default(PENDING)
  targetCommitSha String?

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  errorCode    String?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  nextRetryAt DateTime?

  // Reserved for future worker claiming and recovery.
  lockedAt DateTime?
  lockedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
  @@index([repositoryId, status])
  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("indexing_job")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RepositorySnapshot {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  commitSha     String
  treeSha       String
  branchName    String?
  commitMessage String?
  commitAuthor  String?
  committedAt   DateTime?

  status       SnapshotProcessingStatus @default(PENDING)
  completeness SnapshotCompleteness?

  totalFiles    Int    @default(0)
  eligibleFiles Int    @default(0)
  storedFiles   Int    @default(0)
  skippedFiles  Int    @default(0)
  failedFiles   Int    @default(0)
  totalBytes    BigInt @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files           SnapshotFile[]
  codeAnalyses    CodeAnalysis[]
  aiConversations AIConversation[]

  @@unique([repositoryId, commitSha])
  @@index([repositoryId, createdAt])
  @@index([status])
}

model SnapshotFile {
  id         String             @id @default(cuid())
  snapshotId String
  snapshot   RepositorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  path      String
  name      String
  extension String?
  category  SnapshotFileCategory?

  gitBlobSha  String?
  contentHash String?
  sizeBytes   BigInt?
  storageKey  String?

  status      SnapshotFileStatus @default(DISCOVERED)
  skipReason  String?
  failureCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysisFiles AnalysisFile[]

  @@unique([snapshotId, path])
  @@index([snapshotId, status])
}

// ---------------------------------------------------------------------------
// Sprint 03 - Code intelligence
//
// Relational records are the source of truth. AnalysisGraph is a derived read
// model that can be regenerated from them. Every execution creates a new
// CodeAnalysis; nothing is ever updated across runs.
// ---------------------------------------------------------------------------

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum AnalysisFileStatus {
  ANALYSED
  ANALYSED_WITH_ERRORS
  CONFIG
  SKIPPED
  FAILED
}

enum AnalysisSymbolKind {
  FUNCTION
  CLASS
  METHOD
  INTERFACE
  TYPE
  VARIABLE
  ENUM
}

enum ModuleDependencyKind {
  IMPORT
  SIDE_EFFECT_IMPORT
  DYNAMIC_IMPORT
  REQUIRE
  RE_EXPORT
  EXPORT_ALL
}

enum ModuleSystem {
  ESM
  CJS
}

enum ResolutionStatus {
  RESOLVED
  UNRESOLVED
  AMBIGUOUS
  EXTERNAL
}

enum CodeCallKind {
  CALL
  NEW
  SUPER
}

enum CodeCallResolution {
  CONFIRMED
  POSSIBLE
  UNRESOLVED
}

enum CodeRelationKind {
  EXTENDS
  IMPLEMENTS
  REFERENCES
}

enum DiagnosticSeverity {
  ERROR
  WARNING
  INFO
}

enum DiagnosticSource {
  SNAPSHOT
  PARSER
  EXTRACTOR
  RESOLVER
  LINKER
  CONFIG
  GRAPH
  ENGINE
}

/// One immutable execution of the analysis engine against one snapshot.
model CodeAnalysis {
  id String @id @default(cuid())

  snapshotId String
  snapshot   RepositorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  status               AnalysisStatus        @default(PENDING)
  /// Completeness of the snapshot at analysis time (never upgraded).
  snapshotCompleteness SnapshotCompleteness?
  commitSha            String

  engineVersion      String
  parserVersion      String
  graphSchemaVersion Int?

  /// Counters plus snapshot skip/failure reasons.
  stats        Json?
  errorCode    String?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  files           AnalysisFile[]
  symbols         CodeSymbol[]
  dependencies    ModuleDependency[]
  calls           CodeCall[]
  relations       CodeRelation[]
  diagnostics     AnalysisDiagnostic[]
  graph           AnalysisGraph?
  findingsRuns    FindingsRun[]
  aiConversations AIConversation[]

  @@index([snapshotId, createdAt])
  @@index([repositoryId])
  @@index([requestedById])
  @@index([status])
}

/// File-level analysis boundary (also the unit of future incremental reuse).
model AnalysisFile {
  id         String       @id @default(cuid())
  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  snapshotFileId String?
  snapshotFile   SnapshotFile? @relation(fields: [snapshotFileId], references: [id], onDelete: SetNull)

  path             String
  extension        String
  scriptKind       String?
  moduleSyntax     String
  status           AnalysisFileStatus
  reason           String?
  contentHash      String
  sizeBytes        Int
  lineCount        Int                @default(0)
  syntaxErrorCount Int                @default(0)
  symbolCount      Int                @default(0)

  symbols      CodeSymbol[]
  dependencies ModuleDependency[]
  calls        CodeCall[]
  relations    CodeRelation[]
  diagnostics  AnalysisDiagnostic[]

  @@unique([analysisId, path])
  @@index([analysisId, status])
}

model CodeSymbol {
  /// Deterministic per run: hash(analysisId, stableKey).
  id         String       @id
  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String
  file       AnalysisFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  /// Run-independent identity (path + scope + kind + name + ordinal).
  stableKey     String
  name          String
  kind          AnalysisSymbolKind
  qualifiedName String

  parentId String?
  parent   CodeSymbol?  @relation("SymbolContainment", fields: [parentId], references: [id], onDelete: Cascade)
  children CodeSymbol[] @relation("SymbolContainment")

  isExported      Boolean  @default(false)
  isDefaultExport Boolean  @default(false)
  exportNames     String[]

  startLine   Int
  startColumn Int
  endLine     Int
  endColumn   Int

  details Json

  callsMade       CodeCall[]     @relation("CallCaller")
  callsReceived   CodeCall[]     @relation("CallTarget")
  relationsMade   CodeRelation[] @relation("RelationSource")
  relationsTarget CodeRelation[] @relation("RelationTarget")

  @@unique([analysisId, stableKey])
  @@index([analysisId, fileId])
  @@index([analysisId, kind])
  @@index([analysisId, name])
  @@index([parentId])
}

model ModuleDependency {
  id         String       @id @default(cuid())
  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String
  file       AnalysisFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  key          String
  sourcePath   String
  kind         ModuleDependencyKind
  /// The original specifier exactly as written.
  specifier    String
  isTypeOnly   Boolean              @default(false)
  moduleSystem ModuleSystem
  bindings     Json

  startLine   Int
  startColumn Int
  endLine     Int
  endColumn   Int

  status          ResolutionStatus
  targetPath      String?
  targetAnalysed  Boolean          @default(false)
  externalPackage String?
  reason          String
  candidates      String[]
  evidence        String[]

  @@unique([analysisId, key])
  @@index([analysisId, fileId])
  @@index([analysisId, status])
  @@index([analysisId, targetPath])
}

model CodeCall {
  id         String       @id @default(cuid())
  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String
  file       AnalysisFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  key        String
  sourcePath String
  kind       CodeCallKind

  callerSymbolId String?
  callerSymbol   CodeSymbol? @relation("CallCaller", fields: [callerSymbolId], references: [id], onDelete: Cascade)

  calleeText String
  optional   Boolean            @default(false)
  resolution CodeCallResolution

  targetSymbolId String?
  targetSymbol   CodeSymbol? @relation("CallTarget", fields: [targetSymbolId], references: [id], onDelete: Cascade)

  reason String

  startLine   Int
  startColumn Int
  endLine     Int
  endColumn   Int

  @@unique([analysisId, key])
  @@index([analysisId, fileId])
  @@index([analysisId, resolution])
  @@index([callerSymbolId])
  @@index([targetSymbolId])
}

/// EXTENDS / IMPLEMENTS / REFERENCES evidence between symbols.
model CodeRelation {
  id         String       @id @default(cuid())
  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String
  file       AnalysisFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  key        String
  kind       CodeRelationKind
  sourcePath String

  sourceSymbolId String?
  sourceSymbol   CodeSymbol? @relation("RelationSource", fields: [sourceSymbolId], references: [id], onDelete: Cascade)

  targetName     String
  targetSymbolId String?
  targetSymbol   CodeSymbol? @relation("RelationTarget", fields: [targetSymbolId], references: [id], onDelete: Cascade)

  status ResolutionStatus
  reason String

  startLine   Int
  startColumn Int
  endLine     Int
  endColumn   Int

  @@unique([analysisId, key])
  @@index([analysisId, fileId])
  @@index([analysisId, kind])
}

model AnalysisDiagnostic {
  id         String        @id @default(cuid())
  analysisId String
  analysis   CodeAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String?
  file       AnalysisFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  severity DiagnosticSeverity
  source   DiagnosticSource
  code     String
  message  String
  path     String?
  line     Int?
  column   Int?
  details  Json?

  createdAt DateTime @default(now())

  @@index([analysisId, severity])
  @@index([analysisId, source])
  @@index([analysisId, fileId])
}

/// Derived read model. Always regeneratable from the relational records.
model AnalysisGraph {
  id         String       @id @default(cuid())
  analysisId String       @unique
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  schemaVersion Int
  nodeCount     Int
  edgeCount     Int
  graph         Json

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Sprint 05 - Deterministic findings engine
//
// A FindingsRun is one immutable execution of the rule catalogue against one
// CodeAnalysis. Findings are derived only from that analysis (plus hash-
// verified source facts); nothing is updated across runs. User triage
// (FindingReview) is stored separately so it never alters detection results.
// ---------------------------------------------------------------------------

enum FindingsRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum FindingCategory {
  DEPENDENCY
  COMPLEXITY
  STRUCTURE
  SECURITY
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingCertainty {
  CONFIRMED
  MEASURED
  INDICATOR
}

enum FindingEvidenceKind {
  SOURCE_LOCATION
  DEPENDENCY
  SYMBOL
  METRIC
  CYCLE_EDGE
  PATTERN_MATCH
}

enum FindingRuleRunStatus {
  COMPLETED
  SKIPPED
  FAILED
}

enum FindingReviewStatus {
  ACKNOWLEDGED
  DISMISSED
}

model FindingsRun {
  id String @id @default(cuid())

  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  status FindingsRunStatus @default(PENDING)

  engineVersion    String
  catalogueVersion String
  /// The exact thresholds used; part of reproducibility and comparison.
  thresholds       Json
  /// Run-level limitations (partial analysis, missing facts, skipped rules).
  limitations      Json?
  /// Counters by severity/category, for fast dashboards.
  stats            Json?
  /// Which analysed files lacked verifiable source facts (path -> reason).
  coverage         Json?
  errorCode        String?
  errorMessage     String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  findings Finding[]
  ruleRuns FindingRuleRun[]

  @@index([analysisId, createdAt])
  @@index([repositoryId, createdAt])
  @@index([requestedById])
}

model FindingRuleRun {
  id    String      @id @default(cuid())
  runId String
  run   FindingsRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  ruleId         String
  ruleVersion    String
  status         FindingRuleRunStatus
  reason         String?
  findingCount   Int                  @default(0)
  rejectedCount  Int                  @default(0)
  duplicateCount Int                  @default(0)
  limitations    Json?
  configHash     String

  @@unique([runId, ruleId])
}

model Finding {
  id    String      @id @default(cuid())
  runId String
  run   FindingsRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Stable identity across runs: hash(ruleId, subjectPath, subjectKey).
  fingerprint String

  ruleId      String
  ruleVersion String
  category    FindingCategory
  severity    FindingSeverity
  certainty   FindingCertainty

  title          String
  description    String
  recommendation String

  subjectPath  String
  subjectKey   String
  symbolKey    String?
  primaryLine  Int?
  measurements Json?

  createdAt DateTime @default(now())

  evidence FindingEvidence[]

  @@unique([runId, fingerprint])
  @@index([runId, severity])
  @@index([runId, category])
  @@index([runId, ruleId])
  @@index([runId, subjectPath])
}

model FindingEvidence {
  id        String  @id @default(cuid())
  findingId String
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  ordinal   Int
  kind      FindingEvidenceKind
  filePath  String
  symbolKey String?

  startLine   Int?
  startColumn Int?
  endLine     Int?
  endColumn   Int?

  /// Short excerpt. Credential values are redacted before they reach here.
  excerpt String?
  message String
  data    Json?

  @@unique([findingId, ordinal])
  @@index([findingId])
}

/// User triage for a finding, keyed by repository + fingerprint so it
/// survives re-analysis. Never read by the detection engine.
model FindingReview {
  id String @id @default(cuid())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  fingerprint String

  status FindingReviewStatus
  reason String?

  reviewedById String
  reviewedBy   User   @relation(fields: [reviewedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, fingerprint])
  @@index([repositoryId, status])
}

// ---------------------------------------------------------------------------
// Sprint 06 - AI investigation assistant
//
// A conversation has ONE current snapshot + analysis. Switching is an explicit
// action that records a SYSTEM message. Every message stores its own snapshot,
// analysis and commit (plain columns, no foreign keys) so historical provenance
// can never be rewritten by a later switch. Usage rows are kept when a
// conversation is deleted so daily limits cannot be reset by deleting history.
// ---------------------------------------------------------------------------

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIMessageStatus {
  COMPLETED
  FAILED
}

enum AIUsageStatus {
  SUCCEEDED
  FAILED
}

model AIConversation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  /// Current context; changed only by an explicit snapshot switch.
  snapshotId String
  snapshot   RepositorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  analysisId String
  analysis   CodeAnalysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title      String
  archivedAt DateTime?

  /// Single-flight guard: set while a question is being answered.
  busyUntil    DateTime?
  lastSequence Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]
  usage    AIUsageRecord[]

  @@index([userId, repositoryId, archivedAt, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sequence Int
  role     AIMessageRole
  status   AIMessageStatus @default(COMPLETED)

  /// The question, the plain-text answer, or the switch description.
  content String

  /// Provenance of THIS message (not the conversation's current context).
  snapshotId    String
  analysisId    String
  commitSha     String
  findingsRunId String?

  /// Validated answer (sections, citations, references) for ASSISTANT rows.
  answer    Json?
  retrieval Json?

  provider     String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  errorCode    String?

  createdAt DateTime @default(now())

  @@unique([conversationId, sequence])
}

/// Atomic per-user, per-UTC-day counters used to enforce daily limits.
model AIUsageDay {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String

  requestCount Int @default(0)
  tokenCount   Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([userId, day])
}

/// Audit row per provider request. Survives conversation deletion.
model AIUsageRecord {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?

  provider     String
  model        String
  status       AIUsageStatus
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  errorCode    String?
  durationMs   Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Sprint 07 - Research engine
//
// A ResearchRun is immutable once synthesised: its sources, passages and
// recommendation text never change. Only user-managed fields change afterwards
// (title, archive, recommendation status and note). Source reuse never mutates
// a past run: each run keeps its own link rows with the record as it was
// retrieved, while ResearchSource is an owner-scoped cache.
// ---------------------------------------------------------------------------

enum ResearchRunStatus {
  DISCOVERING
  AWAITING_REVIEW
  SYNTHESIZING
  COMPLETED
  FAILED
}

enum ResearchTrigger {
  FINDING
  QUESTION
}

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  IMPLEMENTED
  ARCHIVED
}

model ResearchRun {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  /// Provenance: the exact snapshot/analysis the repository evidence came from.
  snapshotId    String
  analysisId    String
  commitSha     String
  findingsRunId String?

  trigger            ResearchTrigger
  /// Finding provenance (fingerprint is stable across runs).
  findingId          String?
  findingFingerprint String?
  ruleId             String?
  /// The question researched (finding-derived text or the user's own words).
  question           String

  title  String
  status ResearchRunStatus @default(DISCOVERING)

  queries     Json
  diagnostics Json?
  discarded   Json?
  partial     Boolean @default(false)

  engineVersion String

  /// Validated synthesis (summary, conflicts, limitations, counters).
  synthesis Json?
  provider  String?
  model     String?
  totalTokens Int?
  errorCode String?

  /// Single-flight guard for discovery and synthesis.
  busyUntil  DateTime?
  archivedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  sources         ResearchRunSource[]
  recommendations ResearchRecommendation[]

  @@index([userId, repositoryId, archivedAt, createdAt])
  @@index([userId, findingFingerprint])
}

model ResearchRunSource {
  id    String      @id @default(cuid())
  runId String
  run   ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  sourceKey String
  position  Int

  /// Snapshot of the source record, evaluation and passages as retrieved for THIS run.
  record        Json
  evaluation    Json
  passages      Json
  queryOrdinals Json
  reused        Boolean @default(false)

  /// The user's review decision. Editable only while the run awaits review.
  included Boolean @default(true)

  @@unique([runId, sourceKey])
  @@index([runId, position])
}

model ResearchRecommendation {
  id    String      @id @default(cuid())
  runId String
  run   ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  ordinal Int
  title   String
  concise String
  detail  String
  /// REPOSITORY_AND_RESEARCH | GENERAL_GUIDANCE
  basis   String

  repositoryCitations Json
  sourceCitations     Json

  status          RecommendationStatus @default(PROPOSED)
  note            String?
  statusChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, ordinal])
  @@index([runId, status])
}

/// Owner-scoped reuse cache. Holds only the record (metadata + short excerpt),
/// never full text, and never another user's data.
model ResearchSource {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceKey    String
  canonicalUrl String
  record       Json

  retrievedAt DateTime
  expiresAt   DateTime

  @@unique([userId, sourceKey])
  @@index([userId, canonicalUrl])
}

model ResearchUsageDay {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String

  runCount             Int @default(0)
  synthesisCount       Int @default(0)
  tokenCount           Int @default(0)
  providerRequestCount Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([userId, day])
}
