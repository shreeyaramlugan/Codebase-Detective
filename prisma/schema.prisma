// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RepositoryStatus {
  SUBMITTED
  QUEUED
  INDEXING
  INDEXED
  PARTIALLY_INDEXED
  FAILED
}

enum IndexingJobType {
  REPOSITORY_INDEX
}

enum IndexingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SnapshotProcessingStatus {
  PENDING
  RECOVERING
  DISCOVERING
  INGESTING
  COMPLETED
  FAILED
}

enum SnapshotCompleteness {
  COMPLETE
  PARTIAL
  FAILED
}

enum SnapshotFileStatus {
  DISCOVERED
  ELIGIBLE
  STORED
  SKIPPED
  FAILED
}

enum SnapshotFileCategory {
  SOURCE
  CONFIGURATION
  DOCUMENTATION
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  repositories Repository[]
  codeAnalyses CodeAnalysis[]
  sessions     Session[]
  accounts     Account[]

  @@map("user")
}

model Repository {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  provider   String  @default("github")
  externalId String?
  githubId   BigInt?

  ownerLogin String
  name       String
  fullName   String
  htmlUrl    String

  description   String?
  visibility    String  @default("PUBLIC")
  defaultBranch String?
  language      String?
  stars         Int     @default(0)
  forks         Int     @default(0)
  lastCommitSha String?

  status RepositoryStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  indexingJobs IndexingJob[]
  snapshots    RepositorySnapshot[]
  codeAnalyses CodeAnalysis[]

  @@unique([ownerId, fullName])
  @@unique([ownerId, githubId])
  @@index([ownerId])
  @@index([ownerId, status])
}

model IndexingJob {
  id String @id @default(cuid())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  type            IndexingJobType   @default(REPOSITORY_INDEX)
  status          IndexingJobStatus @default(PENDING)
  targetCommitSha String?

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  errorCode    String?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  nextRetryAt DateTime?

  // Reserved for future worker claiming and recovery.
  lockedAt DateTime?
  lockedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
  @@index([repositoryId, status])
  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("indexing_job")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RepositorySnapshot {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  commitSha     String
  treeSha       String
  branchName    String?
  commitMessage String?
  commitAuthor  String?
  committedAt   DateTime?

  status       SnapshotProcessingStatus @default(PENDING)
  completeness SnapshotCompleteness?

  totalFiles    Int    @default(0)
  eligibleFiles Int    @default(0)
  storedFiles   Int    @default(0)
  skippedFiles  Int    @default(0)
  failedFiles   Int    @default(0)
  totalBytes    BigInt @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files        SnapshotFile[]
  codeAnalyses CodeAnalysis[]

  @@unique([repositoryId, commitSha])
  @@index([repositoryId, createdAt])
  @@index([status])
}

model SnapshotFile {
  id         String             @id @default(cuid())
  snapshotId String
  snapshot   RepositorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  path      String
  name      String
  extension String?
  category  SnapshotFileCategory?

  gitBlobSha  String?
  contentHash String?
  sizeBytes   BigInt?
  storageKey  String?

  status      SnapshotFileStatus @default(DISCOVERED)
  skipReason  String?
  failureCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysisFiles AnalysisFile[]

  @@unique([snapshotId, path])
  @@index([snapshotId, status])
}

// ---------------------------------------------------------------------------
// Sprint 03 - Code intelligence
//
// Relational records are the source of truth. AnalysisGraph is a derived read
// model that can be regenerated from them. Every execution creates a new
// CodeAnalysis; nothing is ever updated across runs.
// ---------------------------------------------------------------------------

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum AnalysisFileStatus {
  ANALYSED
  ANALYSED_WITH_ERRORS
  CONFIG
  SKIPPED
  FAILED
}

enum AnalysisSymbolKind {
  FUNCTION
  CLASS
  METHOD
  INTERFACE
  TYPE
  VARIABLE
  ENUM
}

enum ModuleDependencyKind {
  IMPORT
  SIDE_EFFECT_IMPORT
  DYNAMIC_IMPORT
  REQUIRE
  RE_EXPORT
  EXPORT_ALL
}

enum ModuleSystem {
  ESM
  CJS
}

enum ResolutionStatus {
  RESOLVED
  UNRESOLVED
  AMBIGUOUS
  EXTERNAL
}

enum CodeCallKind {
  CALL
  NEW
  SUPER
}

enum CodeCallResolution {
  CONFIRMED
  POSSIBLE
  UNRESOLVED
}

enum CodeRelationKind {
  EXTENDS
  IMPLEMENTS
  REFERENCES
}

enum DiagnosticSeverity {
  ERROR
  WARNING
  INFO
}

enum DiagnosticSource {
  SNAPSHOT
  PARSER
  EXTRACTOR
  RESOLVER
  LINKER
  CONFIG
  GRAPH
  ENGINE
}

/// One immutable execution of the analysis engine against one snapshot.
model CodeAnalysis {
  id String @id @default(cuid())

  snapshotId String
  snapshot   RepositorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  status               AnalysisStatus        @default(PENDING)
  /// Completeness of the snapshot at analysis time (never upgraded).
  snapshotCompleteness SnapshotCompleteness?
  commitSha            String

  engineVersion      String
  parserVersion      String
  graphSchemaVersion Int?

  /// Counters plus snapshot skip/failure reasons.
  stats        Json?
  errorCode    String?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  files        AnalysisFile[]
  symbols      CodeSymbol[]
  dependencies ModuleDependency[]
  calls        CodeCall[]
  relations    CodeRelation[]
  diagnostics  AnalysisDiagnostic[]
  graph        AnalysisGraph?

  @@index([snapshotId, createdAt])
  @@index([repositoryId])
  @@index([requestedById])
  @@index([status])
}

/// File-level analysis boundary (also the unit of future incremental reuse).
model AnalysisFile {
  id         String       @id @default(cuid())
  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  snapshotFileId String?
  snapshotFile   SnapshotFile? @relation(fields: [snapshotFileId], references: [id], onDelete: SetNull)

  path             String
  extension        String
  scriptKind       String?
  moduleSyntax     String
  status           AnalysisFileStatus
  reason           String?
  contentHash      String
  sizeBytes        Int
  lineCount        Int                @default(0)
  syntaxErrorCount Int                @default(0)
  symbolCount      Int                @default(0)

  symbols      CodeSymbol[]
  dependencies ModuleDependency[]
  calls        CodeCall[]
  relations    CodeRelation[]
  diagnostics  AnalysisDiagnostic[]

  @@unique([analysisId, path])
  @@index([analysisId, status])
}

model CodeSymbol {
  /// Deterministic per run: hash(analysisId, stableKey).
  id         String       @id
  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String
  file       AnalysisFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  /// Run-independent identity (path + scope + kind + name + ordinal).
  stableKey     String
  name          String
  kind          AnalysisSymbolKind
  qualifiedName String

  parentId String?
  parent   CodeSymbol?  @relation("SymbolContainment", fields: [parentId], references: [id], onDelete: Cascade)
  children CodeSymbol[] @relation("SymbolContainment")

  isExported      Boolean  @default(false)
  isDefaultExport Boolean  @default(false)
  exportNames     String[]

  startLine   Int
  startColumn Int
  endLine     Int
  endColumn   Int

  details Json

  callsMade       CodeCall[]     @relation("CallCaller")
  callsReceived   CodeCall[]     @relation("CallTarget")
  relationsMade   CodeRelation[] @relation("RelationSource")
  relationsTarget CodeRelation[] @relation("RelationTarget")

  @@unique([analysisId, stableKey])
  @@index([analysisId, fileId])
  @@index([analysisId, kind])
  @@index([analysisId, name])
  @@index([parentId])
}

model ModuleDependency {
  id         String       @id @default(cuid())
  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String
  file       AnalysisFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  key          String
  sourcePath   String
  kind         ModuleDependencyKind
  /// The original specifier exactly as written.
  specifier    String
  isTypeOnly   Boolean              @default(false)
  moduleSystem ModuleSystem
  bindings     Json

  startLine   Int
  startColumn Int
  endLine     Int
  endColumn   Int

  status          ResolutionStatus
  targetPath      String?
  targetAnalysed  Boolean          @default(false)
  externalPackage String?
  reason          String
  candidates      String[]
  evidence        String[]

  @@unique([analysisId, key])
  @@index([analysisId, fileId])
  @@index([analysisId, status])
  @@index([analysisId, targetPath])
}

model CodeCall {
  id         String       @id @default(cuid())
  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String
  file       AnalysisFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  key        String
  sourcePath String
  kind       CodeCallKind

  callerSymbolId String?
  callerSymbol   CodeSymbol? @relation("CallCaller", fields: [callerSymbolId], references: [id], onDelete: Cascade)

  calleeText String
  optional   Boolean            @default(false)
  resolution CodeCallResolution

  targetSymbolId String?
  targetSymbol   CodeSymbol? @relation("CallTarget", fields: [targetSymbolId], references: [id], onDelete: Cascade)

  reason String

  startLine   Int
  startColumn Int
  endLine     Int
  endColumn   Int

  @@unique([analysisId, key])
  @@index([analysisId, fileId])
  @@index([analysisId, resolution])
  @@index([callerSymbolId])
  @@index([targetSymbolId])
}

/// EXTENDS / IMPLEMENTS / REFERENCES evidence between symbols.
model CodeRelation {
  id         String       @id @default(cuid())
  analysisId String
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String
  file       AnalysisFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  key        String
  kind       CodeRelationKind
  sourcePath String

  sourceSymbolId String?
  sourceSymbol   CodeSymbol? @relation("RelationSource", fields: [sourceSymbolId], references: [id], onDelete: Cascade)

  targetName     String
  targetSymbolId String?
  targetSymbol   CodeSymbol? @relation("RelationTarget", fields: [targetSymbolId], references: [id], onDelete: Cascade)

  status ResolutionStatus
  reason String

  startLine   Int
  startColumn Int
  endLine     Int
  endColumn   Int

  @@unique([analysisId, key])
  @@index([analysisId, fileId])
  @@index([analysisId, kind])
}

model AnalysisDiagnostic {
  id         String        @id @default(cuid())
  analysisId String
  analysis   CodeAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String?
  file       AnalysisFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  severity DiagnosticSeverity
  source   DiagnosticSource
  code     String
  message  String
  path     String?
  line     Int?
  column   Int?
  details  Json?

  createdAt DateTime @default(now())

  @@index([analysisId, severity])
  @@index([analysisId, source])
  @@index([analysisId, fileId])
}

/// Derived read model. Always regeneratable from the relational records.
model AnalysisGraph {
  id         String       @id @default(cuid())
  analysisId String       @unique
  analysis   CodeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  schemaVersion Int
  nodeCount     Int
  edgeCount     Int
  graph         Json

  createdAt DateTime @default(now())
}
