generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RepositoryStatus {
  SUBMITTED
  QUEUED
  INDEXING
  INDEXED
  PARTIALLY_INDEXED
  FAILED
}

enum IndexingJobType {
  REPOSITORY_INDEX
}

enum IndexingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SnapshotProcessingStatus {
  PENDING
  RECOVERING
  DISCOVERING
  INGESTING
  COMPLETED
  FAILED
}
enum SnapshotCompleteness {
  COMPLETE
  PARTIAL
  FAILED
}

enum SnapshotFileStatus {
  DISCOVERED
  ELIGIBLE
  STORED
  SKIPPED
  FAILED
}

enum SnapshotFileCategory {
  SOURCE
  CONFIGURATION
  DOCUMENTATION
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  repositories Repository[]
  sessions     Session[]
  accounts     Account[]

  @@map("user")
}

model Repository {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  provider   String  @default("github")
  externalId String?
  githubId   BigInt?

  ownerLogin String
  name       String
  fullName   String
  htmlUrl    String

  description   String?
  visibility    String  @default("PUBLIC")
  defaultBranch String?
  language      String?
  stars         Int     @default(0)
  forks         Int     @default(0)
  lastCommitSha String?

  status RepositoryStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  indexingJobs IndexingJob[]
  snapshots    RepositorySnapshot[]

  @@unique([ownerId, fullName])
  @@unique([ownerId, githubId])
  @@index([ownerId])
  @@index([ownerId, status])
}

model IndexingJob {
  id String @id @default(cuid())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  type            IndexingJobType   @default(REPOSITORY_INDEX)
  status          IndexingJobStatus @default(PENDING)
  targetCommitSha String?

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  errorCode    String?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  nextRetryAt DateTime?

  // Reserved for future worker claiming and recovery.
  lockedAt DateTime?
  lockedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
  @@index([repositoryId, status])
  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("indexing_job")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RepositorySnapshot {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  commitSha     String
  treeSha       String
  branchName    String?
  commitMessage String?
  commitAuthor  String?
  committedAt   DateTime?

  status       SnapshotProcessingStatus @default(PENDING)
  completeness SnapshotCompleteness?

  totalFiles    Int    @default(0)
  eligibleFiles Int    @default(0)
  storedFiles   Int    @default(0)
  skippedFiles  Int    @default(0)
  failedFiles   Int    @default(0)
  totalBytes    BigInt @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files SnapshotFile[]

  @@unique([repositoryId, commitSha])
  @@index([repositoryId, createdAt])
  @@index([status])
}

model SnapshotFile {
  id         String             @id @default(cuid())
  snapshotId String
  snapshot   RepositorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  path      String
  name      String
  extension String?
  category  SnapshotFileCategory?

  gitBlobSha  String?
  contentHash String?
  sizeBytes   BigInt?
  storageKey  String?

  status      SnapshotFileStatus @default(DISCOVERED)
  skipReason  String?
  failureCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([snapshotId, path])
  @@index([snapshotId, status])
}
