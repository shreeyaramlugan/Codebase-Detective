# .env.example
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
BETTER_AUTH_SECRET="GENERATE_A_RANDOM_SECRET"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
AI_PROVIDER="mock"
AI_MODEL="mock-v1"
SOURCE_STORAGE_PROVIDER="local"
SOURCE_STORAGE_ROOT="./storage"

# Sprint 06 - AI investigation assistant (server-side only; never prefix with NEXT_PUBLIC_)
# Set AI_PROVIDER="gemini" and provide a key to use Google Gemini. "mock" never produces grounded answers.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_MODEL="gemini-3.8-flash"
AI_REQUEST_TIMEOUT_MS="60000"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
AI_DAILY_REQUEST_LIMIT="30"
AI_DAILY_TOKEN_LIMIT="200000"
AI_MAX_QUESTION_CHARS="2000"
AI_MAX_CONTEXT_CHARS="24000"
AI_MAX_OUTPUT_TOKENS="1500"
AI_REQUEST_TIMEOUT_MS="30000"
RESEARCH_CONTACT_EMAIL=""
RESEARCH_DAILY_RUN_LIMIT="10"
RESEARCH_DAILY_SYNTHESIS_LIMIT="10"
RESEARCH_DAILY_TOKEN_LIMIT="150000"
RESEARCH_DAILY_PROVIDER_REQUEST_LIMIT="200"

# Sprint 08 - Production worker (run with `npm run worker`)
# "worker" = jobs are executed by the separate worker process (required in production).
# "inline" = development convenience only: the web process runs jobs itself. Ignored in production.
BACKGROUND_EXECUTION="worker"
LOG_LEVEL="info"
WORKER_CONCURRENCY="2"
WORKER_POLL_INTERVAL_MS="2000"
WORKER_HEARTBEAT_INTERVAL_MS="15000"
# Must be at least 3x the heartbeat interval.
WORKER_STALE_AFTER_MS="90000"
WORKER_RECOVERY_INTERVAL_MS="30000"
WORKER_SHUTDOWN_GRACE_MS="30000"
# Stop claiming new jobs while the process uses more than this much memory (0 disables).
WORKER_MAX_RSS_MB="1536"
# Health endpoints (/healthz, /readyz). 0 disables the HTTP server.
WORKER_HEALTH_PORT="3101"
WORKER_HEALTH_HOST="127.0.0.1"
# Optional: restrict this worker to some job types (comma separated), e.g. CODE_ANALYSIS,FINDINGS_GENERATION
WORKER_JOB_TYPES=""
# Optional: one timeout (ms) for every job type, replacing the per-type defaults.
WORKER_JOB_TIMEOUT_MS=""
# Optional: stable worker name shown in logs and the operator view.
WORKER_ID=""
# Operators who may see queue statistics and retry failed jobs. Comma separated USER IDS (not emails).
WORKER_ADMIN_USER_IDS=""
